# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Environment
.env
.env.local

# Model weights & caches (never commit these)
models/
*.safetensors
*.gguf
*.bin
.cache/
huggingface/

# Remote execution scratch: the folder pushed to Kaggle is assembled from
# src/inferstack/remote/kernels/, and the folder pulled back is raw session
# output. Committing either would duplicate the source or the artifacts.
kernel-build*/
kaggle-out*/
# Working directories for scripts/verify_observability.py. The name changed
# once; both are ignored so a stale one cannot be committed by accident.
.stack-verify/
.prometheus-verify/

# Benchmark artifacts: raw runs are local, curated results are committed
artifacts/runs/
artifacts/**/*.raw.jsonl
!artifacts/curated/

# Logs
logs/
*.log

# Local tool configuration
.claude/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
