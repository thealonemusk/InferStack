# Copy to .env and edit. Every value here overrides the active profile YAML.
# Nested fields use a double underscore: INFERSTACK_<SECTION>__<FIELD>

# Which profile to load: local-cpu | colab-t4 | kaggle-2xt4
INFERSTACK_PROFILE=local-cpu

# Engine overrides (Phase 1+)
# INFERSTACK_ENGINE__MODEL=Qwen/Qwen2.5-1.5B-Instruct
# INFERSTACK_ENGINE__MAX_NUM_SEQS=64
# INFERSTACK_ENGINE__ENABLE_PREFIX_CACHING=true

# Gateway overrides (Phase 2+)
# INFERSTACK_GATEWAY__REQUIRE_AUTH=true
# INFERSTACK_GATEWAY__API_KEYS=["sk-local-dev"]

# Observability (Phase 3+)
# INFERSTACK_OBSERVABILITY__LOG_FORMAT=json

# Hugging Face token, only needed for gated models
# HF_TOKEN=
